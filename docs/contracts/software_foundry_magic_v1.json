{
  "schema_version": 1,
  "contract_id": "software-foundry-magic-v1",
  "status": "accepted_product_intent_source_implementation_requires_pwq",
  "north_star": "IterBrow is a user-owned conversational software foundry that lets Iter research, build, prove, revise, recover, and preserve arbitrary user-requested tab/apps.",
  "intent_checksum": {
    "means": "A user can request a previously unprepared tool in ordinary chat; Iter turns the request into a versioned blueprint, researches useful trusted patterns, authors the app, proves visible behavior and durable data, and safely performs later requested revisions while the user owns all source and data.",
    "does_not_mean": "A CRM generator, a prewritten showcase, an infrastructure-only milestone, or one monolithic physical AtomSpace that every application must use."
  },
  "first_demo": {
    "app_request_owner": "human_at_runtime",
    "preselected_application_forbidden": true,
    "codex_feature_authorship_forbidden": true,
    "required_clauses": [
      "BC-01",
      "BC-02",
      "BC-03",
      "BC-04",
      "BC-05",
      "BC-06",
      "BC-07",
      "BC-08"
    ]
  },
  "clauses": [
    {"id": "BC-01", "name": "conversation_to_blueprint", "evidence": ["conversation_reference", "blueprint_hash", "schema_validation"]},
    {"id": "BC-02", "name": "trustworthy_research", "evidence": ["research_manifest", "source_urls", "license_disposition", "design_notes"]},
    {"id": "BC-03", "name": "iter_authors_proof_app", "evidence": ["authorship_ledger", "factory_baseline_diff"]},
    {"id": "BC-04", "name": "user_owned_project", "evidence": ["project_manifest", "workspace_boundary", "export_reopen"]},
    {"id": "BC-05", "name": "real_visible_function", "evidence": ["external_dom_assertions", "primary_workflow", "visible_acceptance"]},
    {"id": "BC-06", "name": "durable_data", "evidence": ["application_contract_readback", "reload_identity", "restart_identity"]},
