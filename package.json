{
  "name": "iter-browser",
  "version": "0.1.0",
  "description": "Iter agent embedded in its own Chromium shell (Electron) — full CDP access, no extension required.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --dir",
    "dist:mac:dmg": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.iter.browser",
    "productName": "Iter Browser",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "bridge/**/*",
      "renderer/**/*",
      "iter/iter.py",
      "iter/metta_server.py",
      "iter/metta_query_worker.py",
      "iter/hotload_control.py",
      "iter/pwq_service.py",
      "iter/rollup_helper.py",
      "iter/iterbrow_runtime/**/*",
      "iter/tools/**/*",
      "iter/transformations/**/*",
      "iter/channels/**/*",
      "iter/seeds/**/*",
      "iter/vendor/**/*",
      "iter/apps/music/**/*",
      "iter/crm/**/*",
      "iter/mapstation/**/*",
      "iter/nodequest/**/*",
      "iter/nodequest_engine/**/*",
      "iter/prompt.txt",
      "iter/state_manifest.json",
      "iter/AGENTS.md",
      "iter/LICENSE",
      "iter/reprogramming.txt",
      "iter/kb_substrate.metta",
      "iter/capability_lifecycle.metta",
      "iter/self_map.metta",
      "iter/pwq.html",
      "iter/pwq_build_design.md",
      "iter/pwq_seed.json",
      "iter/d3.min.js",
      "iter/atomspace_tab.html",
      "iter/atomspace_v2.html",
      "iter/atomspace_v3.html",
      "iter/stations.html",
      "iter/founder_toolkit.html",
      "iter/superpower_analysis.html",
      "iter/truth_tables.html",
      "iter/build_atomspace_tab.py",
      "iter/build_truth_tab.py",
      "iter/gen_atomspace_html.py",
      "!iter/**/__pycache__{,/**/*}",
      "!iter/**/*.pyc",
      "!iter/**/*.bak*",
      "!iter/**/.DS_Store",
      "!iter/tools/scratch{,/**/*}",
      "!iter/transformations/.runtime{,/**/*}",
      "!iter/crm/data{,/**/*}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Iter Browser uses the camera only when you or Iter open a device-capture tab to take a photo.",
        "NSMicrophoneUsageDescription": "Iter Browser uses the microphone only when you or Iter open a device-capture tab to record audio."
      }
    },
    "extraResources": []
  }
}
